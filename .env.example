# ==============================================================================
# AirSend Web - Server-Side Environment Configuration (.env.example)
# ==============================================================================
# IMPORTANT ARCHITECTURAL NOTE:
# - ZERO usage of NEXT_PUBLIC_* variables.
# - This file is STRICTLY for the Node.js / Server-Side runtime (SSR & Server Components).
# - Client-side runtime configuration is loaded dynamically from `public/config.js`
#   via `window.__RUNTIME_CONFIG__`. This allows you to deploy Docker containers or
#   Kubernetes pods across dev/stage/prod without rebuilding the Next.js bundle!
# ==============================================================================

# Server Network & Runtime
PORT=3000
NODE_ENV=development

# Backend API Configuration (Server SSR fallback)
BASE_URL="http://localhost:9503"
API_URL="http://localhost:9503/api/v1/imap"
API_VERSION="v1"

# Application Metadata
APP_NAME="AirSend"
APP_VERSION="1.0.0"

# Features
ENABLE_WEBPUSH=true
