# ==============================================================================
# AirSend Web - Environment Configuration (.env.example)
# ==============================================================================
# `pnpm dev` and `pnpm build` generate public/config.js from these values.
# Anything written to public/config.js is visible to every browser user.
# Do not put passwords, tokens, or other secrets in these settings.
# ==============================================================================

# Backend URLs
BASE_URL="http://localhost:9503"
API_URL="http://localhost:9503/api/v1/imap"
CALENDAR_API_URL="http://localhost:8443"
API_VERSION="v1"

# Application Metadata
APP_NAME="AirSend"
APP_VERSION="1.0.0"

# Features
ENABLE_WEBPUSH=true
